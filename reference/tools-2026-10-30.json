{
  "tools": [
    {
      "name": "search_cities",
      "title": "Find the right city",
      "description": "Search available cities by name and country. Results include stable IDs and IANA time zones.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "country": {
            "type": "string",
            "pattern": "^[a-zA-Z]{2}$"
          },
          "limit": {
            "default": 8,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_calculation_methods",
      "title": "Explore calculation methods",
      "description": "List the actual presets supported by the shared prayer engine, with their settings.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_prayer_times",
