    {
      "name": "convert_calendar",
      "title": "Convert calendar dates",
      "description": "Convert Hijri and Gregorian dates in either direction with an explicit calendar method.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "gregorian-to-hijri",
              "hijri-to-gregorian"
            ]
          },
          "date": {
            "type": "string"
          },
          "hijri": {
            "type": "object",
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1300,
                "maximum": 1600
              },
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              }
            },
            "required": [
              "year",
              "month",
              "day"
            ],
            "additionalProperties": false
          },
          "method": {
            "default": "islamic-umalqura",
            "type": "string",
            "enum": [
              "islamic-umalqura",
              "islamic-civil"
            ]
          },
          "adjustment": {
            "default": 0,
            "type": "integer",
            "minimum": -2,
            "maximum": 2
          }
        },
        "required": [
          "direction"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_calendar_month",
      "title": "Plan with both calendars",
      "description": "Get a Hijri or Gregorian month with corresponding dates in the other calendar.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "calendar": {
            "type": "string",
            "enum": [
              "hijri",
              "gregorian"
            ]
          },
          "year": {
            "type": "integer",
            "minimum": 1300,
            "maximum": 2100
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "method": {
            "default": "islamic-umalqura",
            "type": "string",
            "enum": [
              "islamic-umalqura",
              "islamic-civil"
            ]
          },
          "adjustment": {
            "default": 0,
            "type": "integer",
            "minimum": -2,
            "maximum": 2
          }
        },
        "required": [
          "calendar",
          "year",
          "month"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_islamic_days",
      "title": "Look ahead to Islamic days",
      "description": "List calculated planning dates, with local moon-sighting and observance qualifications.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "gregorian_year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "method": {
            "default": "islamic-umalqura",
            "type": "string",
            "enum": [
              "islamic-umalqura",
              "islamic-civil"
            ]
          },
          "adjustment": {
            "default": 0,
            "type": "integer",
            "minimum": -2,
            "maximum": 2
          }
        },
        "required": [
          "gregorian_year"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "convert_timezone",
      "title": "Convert a moment in time",
      "description": "Convert an unambiguous timestamp to another IANA time zone, including daylight saving.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "instant": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "time_zone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "instant",
          "time_zone"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
