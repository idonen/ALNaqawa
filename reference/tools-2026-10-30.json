                "maximum": 60
              },
              "isha": {
                "type": "integer",
                "minimum": -60,
                "maximum": 60
              }
            },
            "additionalProperties": false
          },
          "days": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "required": [
          "city_id",
          "date"
